<mujoco model="g1_29dof_with_hand thick valve contact scene">
  <include file="g1_29dof_old_freebase_with_hand.xml"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="2 0.02 0.001"/>
    <!-- 绕 z 轴旋转 180 度，让轮盘位于靠近机器人的一侧。
         阀门整体放到右前方，避免机身挤到阀门支架。 -->
    <body name="valve_spawn" pos="0.59 0.00 0.00" quat="0 0 0 1">
      <include file="valve_thick_body_include.xml"/>
    </body>
  </worldbody>

  <contact>
    <!-- 阀门支架和转轮由 hinge 连接，几何上会相交；这些内部接触不是抓握接触，
         如果不排除会产生极大的非物理接触力并污染机器人站姿。 -->
    <exclude body1="valve_spawn" body2="valve_wheel"/>
  </contact>

  <equality>
    <!-- 仅保留为诊断接口；真实接触抓握测试不启用 equality 连接。 -->
    <connect name="right_hand_valve_connect" site1="right_contact_grasp_proxy_site" site2="right_hand_valve_site" active="false" solref="0.20 1" solimp="0.45 0.85 0.02"/>
    <weld name="right_hand_valve_weld" body1="right_rubber_hand" body2="right_hand_valve_anchor" active="false" solref="0.002 1" solimp="0.95 0.99 0.001"/>
  </equality>
</mujoco>
