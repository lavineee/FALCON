<mujoco model="g1_29dof_with_hand ribbed-round-grip valve contact scene">
  <include file="g1_29dof_old_freebase_with_hand_fakehand700g.xml"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="45" elevation="-28"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="2 0.02 0.001"/>
    <!-- 阀门放在机器人右前方，轮盘朝向机器人，留出机身和支架间隙。 -->
    <body name="valve_spawn" pos="0.58 0.00 0.00" quat="0 0 0 1">
      <include file="valve_ribbed_round_grip_body_include.xml"/>
    </body>
  </worldbody>

  <contact>
    <!-- 支架/阀杆和轮盘几何上有装配重叠；排除内部接触，只保留手-轮盘真实接触。 -->
    <exclude body1="valve_spawn" body2="valve_wheel"/>
  </contact>

  <equality>
    <!-- 保留诊断接口，默认不启用；真实接触抓握不依赖 equality。 -->
    <connect name="right_hand_valve_connect" site1="right_contact_grasp_proxy_site" site2="right_hand_valve_site" active="false" solref="0.20 1" solimp="0.45 0.85 0.02"/>
    <weld name="right_hand_valve_weld" body1="right_rubber_hand" body2="right_hand_valve_anchor" active="false" solref="0.002 1" solimp="0.95 0.99 0.001"/>
  </equality>
</mujoco>
