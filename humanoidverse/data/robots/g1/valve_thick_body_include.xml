<!-- 真实接触抓握测试用的整体加粗阀门。
     保留原轮盘拓扑，只整体加粗轮圈、辐条和中心 hub，不额外增加局部抓取件。 -->
<body name="valve_stand" pos="0 0 0.00">

    <geom name="valve_pipe"
          type="cylinder"
          size="0.06 0.5"
          pos="0 0 0.5"
          rgba="0.35 0.35 0.38 1"
          contype="1"
          conaffinity="1"
          friction="1.2 0.01 0.001"/>

    <geom name="valve_block"
          type="box"
          size="0.10 0.10 0.08"
          pos="0 0 1.00"
          rgba="0.35 0.35 0.38 1"
          contype="1"
          conaffinity="1"
          friction="1.2 0.01 0.001"/>

    <geom name="valve_stem"
          type="cylinder"
          size="0.022 0.065"
          pos="0.06 0 1.00"
          euler="0 1.57079632679 0"
          rgba="0.25 0.25 0.28 1"
          contype="1"
          conaffinity="1"
          friction="1.2 0.01 0.001"/>

    <body name="valve_wheel" pos="0.12 0 1.00">
