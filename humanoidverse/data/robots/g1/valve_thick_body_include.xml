               type="hinge"
               axis="1 0 0"
               pos="0 0 0"
               limited="false"
               damping="1.00"
               frictionloss="1.20"/>

        <geom name="wheel_hub"
              type="cylinder"
              size="0.045 0.014"
              pos="0 0 0"
              euler="0 1.57079632679 0"
              rgba="0.75 0.10 0.10 1"
              contype="1"
              conaffinity="1"
              friction="1.8 0.02 0.002"/>

