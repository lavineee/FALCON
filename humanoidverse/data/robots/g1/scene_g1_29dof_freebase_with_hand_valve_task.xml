<mujoco model="g1_29dof_with_hand valve task scene">
  <include file="g1_29dof_old_freebase_with_hand.xml"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="2 0.02 0.001"/>
    <!-- The 180 deg z rotation keeps the grasp site on the robot-facing side.
         valve_center_world.x = valve_spawn.x - 0.12. The wheel is placed
         farther forward and slightly to the robot's right so the torso does
         not crowd the valve during the first grasp/turn tests. -->
    <body name="valve_spawn" pos="0.62 -0.04 0.00" quat="0 0 0 1">
      <include file="valve_body_include.xml"/>
    </body>
  </worldbody>

  <equality>
    <!-- First-stage grasp surrogate: constrain the palm grasp point to the
         valve handle point, but do not force palm orientation. This matches
         the current position-only IK controller better than a full weld. -->
    <connect name="right_hand_valve_connect" site1="right_palm_grasp_center" site2="right_hand_valve_site" active="false" solref="0.08 1" solimp="0.70 0.95 0.01"/>
    <!-- Kept for later experiments after palm orientation control is added. -->
    <weld name="right_hand_valve_weld" body1="right_rubber_hand" body2="right_hand_valve_anchor" active="false" solref="0.002 1" solimp="0.95 0.99 0.001"/>
  </equality>
</mujoco>
