#!/usr/bin/env bash
set -euo pipefail

SESSION="${SESSION:-falcon_6d_wrench}"
REPO="${REPO:-$PWD}"
CONDA_ENV="${CONDA_ENV:-fcgym}"
NUM_ENVS="${NUM_ENVS:-256}"
ITERATIONS="${ITERATIONS:-100}"
SEED="${SEED:-1}"
STEPS_PER_ENV="${STEPS_PER_ENV:-24}"
CHECKPOINT="${CHECKPOINT:-${REPO}/model_10000.pt}"
PROJECT_NAME="${PROJECT_NAME:-server_warmstart_6d_wrench}"
EXPERIMENT_NAME="${EXPERIMENT_NAME:-warmstart_6d_wrench_${NUM_ENVS}env_${ITERATIONS}it_seed${SEED}}"
LOGURU_LEVEL="${LOGURU_LEVEL:-INFO}"

if [[ "${1:-}" != "--inside-tmux" ]]; then
  if tmux has-session -t "${SESSION}" 2>/dev/null; then
    echo "tmux session already exists: ${SESSION}" >&2
    echo "Attach with: tmux attach -t ${SESSION}" >&2
    exit 2
  fi
  echo "Starting tmux session: ${SESSION}"
  tmux new-session -d -s "${SESSION}" "cd '${REPO}' && '${REPO}/tools/server_training/run_6d_wrench_warmstart_tmux' --inside-tmux"
  echo "Attach with: tmux attach -t ${SESSION}"
  exit 0
fi

cd "${REPO}"

if [[ ! -f "${CHECKPOINT}" ]]; then
  echo "Checkpoint not found: ${CHECKPOINT}" >&2
  exit 2
fi

if command -v conda >/dev/null 2>&1; then
  eval "$(conda shell.bash hook)"
  conda activate "${CONDA_ENV}"
else
  echo "conda command not found; assuming Python environment is already active."
fi

export LOGURU_LEVEL

echo "Repository: ${REPO}"
echo "Session: ${SESSION}"
echo "Checkpoint: ${CHECKPOINT}"
echo "num_envs=${NUM_ENVS}, iterations=${ITERATIONS}, seed=${SEED}"
echo "project_name=${PROJECT_NAME}"
echo "experiment_name=${EXPERIMENT_NAME}"

python humanoidverse/train_agent.py \
  +exp=decoupled_locomotion_stand_height_waist_wbc_6d_wrench_ma_ppo_ma_env \
  +simulator=isaacgym \
  +domain_rand=domain_rand_rl_gym \
  +rewards=dec_loco/reward_dec_loco_stand_height_ma_diff_force \
  +robot=g1/g1_29dof_waist_fakehand \
  +terrain=terrain_locomotion_plane \
  +obs=dec_loco/g1_29dof_obs_6d_wrench_history_wolinvel_ma \
  "project_name=${PROJECT_NAME}" \
  "experiment_name=${EXPERIMENT_NAME}" \
  "num_envs=${NUM_ENVS}" \
  "headless=True" \
  "use_wandb=False" \
  "seed=${SEED}" \
  "env.config.wrench.mode=force_torque" \
  "env.config.wrench.curriculum_mode=adaptive_floor" \
  "env.config.wrench.torque_scale_start_after_force_scale=0.0" \
  "+env.config.wrench.curriculum_steps_per_iteration=${STEPS_PER_ENV}" \
  "algo.config.num_steps_per_env=${STEPS_PER_ENV}" \
  "algo.config.num_learning_iterations=${ITERATIONS}" \
  "algo.config.warm_start.enabled=True" \
  "algo.config.warm_start.checkpoint_path=${CHECKPOINT}" \
  "algo.config.warm_start.load_actors=True" \
  "algo.config.warm_start.load_critics=False" \
  "algo.config.warm_start.load_optimizer=False" \
  "algo.config.warm_start.strict_actor_shape=True"
